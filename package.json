		"url": "git+https://github.com/unrelentingfox/pi-context-cap.git"
	},
	"homepage": "https://github.com/unrelentingfox/pi-context-cap#readme",
	"bugs": {
		"url": "https://github.com/unrelentingfox/pi-context-cap/issues"
	},
	"type": "module",
	"scripts": {
		"test": "node --test test/"
	},
	"pi": {
